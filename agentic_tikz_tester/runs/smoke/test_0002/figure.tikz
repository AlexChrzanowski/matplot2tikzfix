\begin{tikzpicture}

\definecolor{darkgray176}{RGB}{176,176,176}
\definecolor{steelblue}{RGB}{70,130,180}

\begin{axis}[
height=4.8in,
tick align=outside,
tick pos=left,
title={Bar chart with rotated labels},
width=6.4in,
x grid style={darkgray176},
xlabel={Category},
xmin=-0.69, xmax=5.69,
xtick style={color=black},
xtick={0,1,2,3,4,5},
xticklabel style={rotate=45.0,anchor=east},
xticklabels={Alpha,Beta,Gamma,Delta,Epsilon,Zeta},
y grid style={darkgray176},
ylabel={Value},
ymajorgrids,
ymin=0, ymax=25,
ytick style={color=black}
]
\draw[draw=black,fill=steelblue] (axis cs:-0.4,0) rectangle (axis cs:0.4,14);
\draw[draw=black,fill=steelblue] (axis cs:0.6,0) rectangle (axis cs:1.4,8);
\draw[draw=black,fill=steelblue] (axis cs:1.6,0) rectangle (axis cs:2.4,20);
\draw[draw=black,fill=steelblue] (axis cs:2.6,0) rectangle (axis cs:3.4,5);
\draw[draw=black,fill=steelblue] (axis cs:3.6,0) rectangle (axis cs:4.4,17);
