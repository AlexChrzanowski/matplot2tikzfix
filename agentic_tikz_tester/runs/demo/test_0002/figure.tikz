\definecolor{salmon255107107}{RGB}{255,107,107}

\begin{axis}[
height=6in,
tick align=outside,
tick pos=left,
title={Bar Chart with Rotated Labels and Value Annotations},
width=10in,
x grid style={darkgray176},
xmin=-0.64, xmax=4.64,
xtick style={color=black},
xtick={0,1,2,3,4},
xticklabel style={rotate=45.0,anchor=east},
xticklabels={Alpha,Beta,Gamma,Delta,Epsilon},
y grid style={darkgray176},
ylabel={Values},
ymajorgrids,
ymin=0, ymax=71.3,
ytick style={color=black}
]
\draw[draw=black,fill=salmon255107107,semithick] (axis cs:-0.4,0) rectangle (axis cs:0.4,23);
\draw[draw=black,fill=mediumturquoise78205196,semithick] (axis cs:0.6,0) rectangle (axis cs:1.4,45);
\draw[draw=black,fill=mediumturquoise69183209,semithick] (axis cs:1.6,0) rectangle (axis cs:2.4,56);
\draw[draw=black,fill=lightsalmon,semithick] (axis cs:2.6,0) rectangle (axis cs:3.4,38);
\draw[draw=black,fill=lightblue152216200,semithick] (axis cs:3.6,0) rectangle (axis cs:4.4,62);
\draw (axis cs:0,23) node[
  scale=0.5,
  anchor=south,
  text=black,
  rotate=0.0
]{\bfseries 23};
\draw (axis cs:1,45) node[
  scale=0.5,
  anchor=south,
  text=black,
  rotate=0.0
]{\bfseries 45};
\draw (axis cs:2,56) node[
  scale=0.5,
  anchor=south,
  text=black,
  rotate=0.0
]{\bfseries 56};
\draw (axis cs:3,38) node[
  scale=0.5,
  anchor=south,
  text=black,
  rotate=0.0
]{\bfseries 38};
\draw (axis cs:4,62) node[
  scale=0.5,
  anchor=south,
  text=black,
  rotate=0.0
]{\bfseries 62};
\end{axis}

