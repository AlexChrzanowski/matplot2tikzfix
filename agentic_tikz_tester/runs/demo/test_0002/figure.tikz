\begin{tikzpicture}

\definecolor{darkgray176}{RGB}{176,176,176}
\definecolor{lightblue152216200}{RGB}{152,216,200}
\definecolor{lightsalmon}{RGB}{255,160,122}
\definecolor{mediumturquoise69183209}{RGB}{69,183,209}
